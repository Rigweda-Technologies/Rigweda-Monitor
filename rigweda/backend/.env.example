NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rigweda
DATABASE_SSL=false
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=35000
API_RATE_LIMIT_PER_MINUTE=1200
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=info
PASSWORD_PEPPER=replace-with-a-long-random-secret-stored-outside-git
JWT_ACCESS_SECRET=replace-with-an-independent-long-random-secret
SESSION_TOKEN_PEPPER=replace-with-another-independent-random-secret
DATA_ENCRYPTION_KEY=replace-with-a-dedicated-field-encryption-secret
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
BOOTSTRAP_ADMIN_EMAIL=admin@rigweda.com
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
