SCREENSHOT_INTERVAL_MS=30000
SCREENSHOT_UPLOAD_BATCH_SIZE=30
SCREENSHOT_UPLOAD_CONCURRENCY=4
SCREENSHOT_UPLOAD_API_URL=http://localhost:8000/api/agents
#HRMS_BACKEND_URL=https://rigweda-hrms-backend.onrender.com/api
#HRMS_LOGIN_URL=https://rigweda-hrms-backend.onrender.com/api/users/login
HRMS_BACKEND_URL=http://localhost:8000/api
HRMS_LOGIN_URL=http://localhost:8000/api/users/login
DESKTOP_BACKEND_URL=https://rigweda-monitor-backend.vercel.app/api
DESKTOP_START_WINDOWS_SERVICE=false
RIGWEDA_MONITOR_FORCE_KEYBOARD_ENABLED=true
RIGWEDA_MONITOR_DATA_ROOT=%LOCALAPPDATA%\rigweda-monitor\data
RIGWEDA_MONITOR_SCREENSHOT_ROOT=%LOCALAPPDATA%\rigweda-monitor\screenshots
RIGWEDA_MONITOR_LOG_ROOT=%LOCALAPPDATA%\rigweda-monitor\logs
RIGWEDA_MONITOR_RUNTIME_ROOT=%LOCALAPPDATA%\rigweda-monitor
RIGWEDA_MONITOR_SCAN_ROOTS=%LOCALAPPDATA%\rigweda-monitor\screenshots;%LOCALAPPDATA%\rigweda-monitor\screenshots
MOUSE_IDLE_THRESHOLD_SECONDS=60
ACTIVITY_HEARTBEAT_SECONDS=60
MONITOR_EXPECTED_PUBLISHER=RigwedaMonitor
